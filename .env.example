# Leave DATABASE_URL unset to use the embedded PGlite database in ./.pglite (zero setup).
# DATABASE_URL=postgres://ai4brain:ai4brain@localhost:5432/ai4brain
# PGLITE_DIR=./.pglite

# AI coach: an open-weight model on Groq. Without a key (or with COACH_LLM=off) the rule-based coach answers instead.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# COACH_LLM=off

# How many reverse proxies sit in front of the app (1 behind nginx or Vercel). Sign-in rate limits then
# use the address your proxy saw, which a client can't forge. Leave unset only when nothing proxies the app.
# AI4B_TRUSTED_PROXIES=1
